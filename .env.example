# ContentMonster — environment variables (documented placeholders; copy to .env).
# NOTE: packages/core modules are still stubs — nothing reads these yet. They land
# with the provider-SDK wiring (see docs/engineering-standards.md → Runtime concerns).

# AI scene generation (charter §2: Nano Banana 2 / Gemini image is primary, Grok is alt)
GEMINI_API_KEY=
GROK_API_KEY=

# Headless two-pass Vision QA (charter D3: required when QA Pass 2 runs headless/CI;
# fail-loud on refusal)
ANTHROPIC_API_KEY=

# Google Drive asset sync + channel OAuth (YouTube/LinkedIn) use JSON credential FILES
# under the gitignored credentials/ dir, not env vars — see
# docs/runbooks/google-drive-setup.md and channels/<ch>/README.md → Secrets.
