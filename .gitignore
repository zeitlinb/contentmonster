# OS
.DS_Store
*.pem

# Secrets / env — NEVER commit
.env
.env.*
!.env.example
secrets/
bzdocs/
credentials/

# Node / TypeScript
node_modules/
dist/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Testing
coverage/

# Logs / temp
*.log
npm-debug.log*
.pnpm-debug.log*
.cache/
tmp/

# Turborepo
.turbo/

# gstack local artifacts (durable state lives in ~/.gstack and docs/state/, not here)
.gstack/
.gstack-worktrees/
.gbrain-source
.omx/
.vercel

# contentmonster — generated output + synced client assets (never committed).
# tenants/<id>/assets/ is RESERVED for Drive-synced client assets (see
# docs/runbooks/google-drive-setup.md) — always ignored, for every tenant.
# Committed brand files belong in tenants/<id>/brand/ or the channel binding's
# assets/ (tenants/<id>/channels/<ch>/assets/), which this pattern does NOT match.
output/
tenants/*/assets/
